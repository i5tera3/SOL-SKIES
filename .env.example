# Sol Skies — environment variables.
# Copy to .env and fill in.

# ── Frontend (Vite — must use VITE_ prefix) ──────────────────────────────────
# Where the frontend should send API requests.
VITE_API_URL=http://localhost:3001

# ── Server ────────────────────────────────────────────────────────────────────
# Express port.
PORT=3001

# Allowed origin for CORS (comma-separate for multiple).
FRONTEND_URL=http://localhost:5173

# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-32-bytes-of-randomness

# ── Solana escrow (devnet) ────────────────────────────────────────────────────
# 64-byte secret key as a JSON array, e.g. [12,34,...]. If unset, the server
# generates a fresh keypair at boot and persists it to .escrow-keypair.json.
# NEVER reuse a devnet key for mainnet.
ESCROW_SECRET_KEY=

# ── Third-party APIs ──────────────────────────────────────────────────────────
# OpenWeatherMap free tier: https://openweathermap.org/api
# If absent, the server returns deterministic mock weather.
WEATHER_API_KEY=
